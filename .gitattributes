# Auto detect text files and perform LF normalization
* text=auto

# Keep the checksummed public snapshot consistent across Windows and Linux.
web/data/*.json text eol=lf

# Preserve document, image and model bytes exactly on every platform.
*.pdf binary
*.pptx binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.webm binary
*.mp4 binary
*.zip binary
*.npz binary
*.pt binary
